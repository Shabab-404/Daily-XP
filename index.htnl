    background: #30303e;
    border-radius: 20px;
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #8b5cf6, #c4b5fd);
    border-radius: inherit;
    transition: width .4s;
}

.progress-caption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
