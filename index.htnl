}

.achievement strong {
    display: block;
    font-size: 12px;
    margin-bottom: 5px;
}

.achievement small {
    color: var(--muted);
    font-size: 10px;
}

.weekly {
    margin-top: 20px;
}

.week-bars {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: end;
    gap: 10px;
    height: 110px;
    margin-top: 20px;
}

.day {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: center;
    gap: 9px;
}

.bar {
    width: 100%;
    max-width: 25px;
    min-height: 5px;
    border-radius: 6px 6px 2px 2px;
    background: #383047;
    transition: height .4s;
}

.bar.today {
    background: linear-gradient(#c4b5fd, #8b5cf6);
}

.day small {
    color: var(--muted);
    font-size: 10px;
}

.empty {
    text-align: center;
    padding: 25px 10px;
    color: var(--muted);
    font-size: 12px;
}

.toast {
    position: fixed;
    bottom: 25px;
    left: 50%;
    transform: translate(-50%, 20px);
    background: #22252f;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 13px 19px;
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
    transition: .25s;
    z-index: 10;
}

.toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.page-card {
    margin-top: 20px;
}

.achievement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
}

.achievement-tile {
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 20px 12px;
    text-align: center;
    background: var(--panel);
}

.achievement-tile .badge-icon {
    margin: 0 auto 12px;
}

.achievement-tile p {
    font-size: 11px;
    color: var(--muted);
    margin-top: 6px;
}

@media (max-width: 1050px) {
    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .xp-card {
        grid-column: 1 / -1;
    }

    .layout {
        grid-template-columns: 1fr;
    }

    .side-column {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .weekly {
        grid-column: 1 / -1;
    }
}

@media (max-width: 700px) {
    .app {
        grid-template-columns: 1fr;
    }

    .sidebar {
        padding: 13px;
        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .logo {
        margin: 0 0 14px 4px;
    }

    .nav-label, .sidebar-bottom {
        display: none;
    }

    .sidebar nav {
        display: flex;
        overflow-x: auto;
        gap: 5px;
    }

    .nav-item {
        flex-shrink: 0;
        margin: 0;
        padding: 10px;
        font-size: 11px;
    }

    main {
        padding: 21px 15px;
    }

    .topbar {
        align-items: flex-start;
    }

    .profile {
        padding: 7px;
    }

    .profile .profile-text {
        display: none;
    }

    .stats {
        gap: 10px;
    }

    .card {
        padding: 17px;
    }

    .stat-number {
        font-size: 24px;
    }

    .add-quest {
        grid-template-columns: 1fr 80px;
    }

    .add-quest input:first-child {
        grid-column: 1 / -1;
    }

    .side-column {
        display: flex;
    }

    .achievement-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
</style>
</head>

<body>
<div class="app">

    <aside class="sidebar">
        <div class="logo">
            <div class="logo-icon">⚔</div>
            <span>DAILY QUEST</span>
        </div>

        <div class="nav-label">YOUR JOURNEY</div>

        <nav>
            <div class="nav-item active" data-page="overview">◈ Overview</div>
            <div class="nav-item" data-page="quests">⚔ Quests</div>
            <div class="nav-item" data-page="achievements">🏆 Achievements</div>
            <div class="nav-item" data-page="statistics">▥ Statistics</div>
        </nav>

        <div class="sidebar-bottom">
            <strong>✦ Keep going.</strong>
            <p>Every completed quest makes you a little stronger. Progress over perfection.</p>
        </div>
    </aside>

    <main>
        <header class="topbar">
            <div>
                <div class="eyebrow" id="dateLabel">YOUR DAILY ADVENTURE</div>
                <h1 id="greeting">Good evening, Adventurer.</h1>
                <p class="subtitle">Small steps. Legendary progress.</p>
            </div>

            <div class="profile">
                <div class="avatar">🧙</div>
                <div class="profile-text">
                    <strong>Adventurer</strong>
                    <small id="profileLevel">Level 1 Explorer</small>
                </div>
                <span class="level-tag" id="levelTag">LVL 1</span>
            </div>
        </header>

        <section class="page active" id="overview">
            <div class="stats">
                <div class="card xp-card">
                    <div class="card-label">✦ TOTAL EXPERIENCE</div>
                    <div class="xp-line">
                        <strong id="xpNumber">0</strong>
                        <span id="xpTarget">/ 100 XP</span>
                    </div>
                    <div class="progress">
                        <div class="progress-fill" id="xpBar"></div>
                    </div>
                    <div class="progress-caption">
                        <span id="xpRemaining">100 XP to next level</span>
                        <span id="xpPercent">0%</span>
                    </div>
                </div>

                <div class="card">
                    <div class="stat-top">
                        <span class="card-label">CURRENT STREAK</span>
                        <span class="stat-icon">🔥</span>
                    </div>
                    <div class="stat-number" id="streakNumber">0 days</div>
                    <div class="stat-description">Keep your momentum going</div>
                </div>

                <div class="card">
                    <div class="stat-top">
                        <span class="card-label">QUESTS DONE</span>
                        <span class="stat-icon">⚔️</span>
                    </div>
                    <div class="stat-number" id="completedNumber">0</div>
                    <div class="stat-description">Lifetime completed quests</div>
                </div>
            </div>

            <div class="layout">
                <section class="card">
                    <div class="section-heading">
                        <h2>⚔ Today's Quests</h2>
                        <span class="count" id="questCount">0 quests</span>
                    </div>
                    <p class="section-description">Complete quests to earn XP and level up.</p>

                    <div class="quest-list" id="questList"></div>

                    <form class="add-quest" id="questForm">
                        <input id="questInput" type="text" maxlength="100"
                               placeholder="Add a new quest..." required>
                        <select id="questReward" aria-label="XP reward">
                            <option value="25">25 XP</option>
                            <option value="50" selected>50 XP</option>
                            <option value="75">75 XP</option>
                            <option value="100">100 XP</option>
                        </select>
                        <button class="btn" type="submit">+ Add</button>
                    </form>
                </section>

                <div class="side-column">
                    <section class="card challenge">
                        <div class="challenge-icon">🎯</div>
                        <div class="eyebrow">DAILY CHALLENGE</div>
                        <h2>Quest Hunter</h2>
                        <p>Complete 3 quests today to claim your bonus experience.</p>
                        <div class="challenge-progress">
                            <span id="challengeText">0 of 3 completed</span>
                            <span id="challengePercent">0%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-fill" id="challengeBar"></div>
                        </div>
                        <p id="challengeReward" style="margin:12px 0 0;color:var(--gold)">Reward: +100 XP</p>
                    </section>

                    <section class="card">
                        <div class="section-heading">
                            <h2>🏆 Achievements</h2>
                            <span class="count" id="achievementCount">0/4</span>
                        </div>
                        <div class="achievement-list" id="achievementList"></div>
                    </section>
                </div>
            </div>
        </section>

        <section class="page" id="quests">
            <div class="card page-card">
                <div class="section-heading">
                    <h2>⚔ Your Quests</h2>
                    <span class="count">Daily mission board</span>
                </div>
                <p class="section-description">Check off your tasks and collect your rewards.</p>
                <div class="quest-list" id="allQuestList"></div>
            </div>
        </section>

        <section class="page" id="achievements">
            <div class="card page-card">
                <div class="section-heading">
                    <h2>🏆 Achievement Hall</h2>
                    <span class="count">Earn your titles</span>
                </div>
                <p class="section-description">Your progress unlocks new achievements.</p>
                <div class="achievement-grid" id="achievementGrid"></div>
            </div>
        </section>

        <section class="page" id="statistics">
            <div class="card page-card">
                <div class="section-heading">
                    <h2>▥ Weekly Progress</h2>
                    <span class="count">Last 7 days</span>
                </div>
                <p class="section-description">See how consistently you have completed quests.</p>
                <div class="week-bars" id="weekBars"></div>
            </div>
            <div class="card page-card">
                <div class="card-label">LIFETIME EXPERIENCE</div>
                <div class="stat-number" id="totalXpStat">0 XP</div>
                <p class="section-description">Every reward adds to your total experience.</p>
                <div class="card-label">LIFETIME QUESTS COMPLETED</div>
                <div class="stat-number" id="totalQuestsStat">0</div>
            </div>
        </section>
    </main>
</div>

<div class="toast" id="toast"></div>

<script>
const $ = id => document.getElementById(id);

const defaultQuests = [
    { id: 1, title: "Study Java for 45 minutes", category: "STUDY", xp: 50, done: false },
    { id: 2, title: "Finish your assignment", category: "UNIVERSITY", xp: 75, done: false },
    { id: 3, title: "Exercise for 20 minutes", category: "HEALTH", xp: 25, done: false },
    { id: 4, title: "Read 10 pages", category: "PERSONAL GROWTH", xp: 25, done: false }
];

const achievementDefinitions = [
    { id: "first", icon: "⚔️", name: "First Blood", description: "Complete your first quest.", test: s => s.completed >= 1 },
    { id: "five", icon: "🎯", name: "Quest Hunter", description: "Complete 5 quests.", test: s => s.completed >= 5 },
    { id: "xp", icon: "✨", name: "Rising Hero", description: "Earn 500 total XP.", test: s => s.xp >= 500 },
    { id: "level5", icon: "👑", name: "Elite Adventurer", description: "Reach level 5.", test: s => s.level >= 5 }
];

const today = () => {
    const d = new Date();
    return ${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')};
};

function freshState() {
    return {
        xp: 0,
        completed: 0,
        level: 1,
        streak: 0,
        lastCompletedDay: "",
        lastVisitDay: today(),
        questDate: today(),
        quests: defaultQuests.map(q => ({ ...q })),
        completedDays: {},
        claimedChallenges: [],
        nextId: 5
    };
}

function loadState() {
    try {
        const saved = localStorage.getItem("dailyQuestSave");
        if (!saved) return freshState();

        const state = { ...freshState(), ...JSON.parse(saved) };

        if (state.questDate !== today()) {
            state.questDate = today();
            state.quests = defaultQuests.map(q => ({ ...q, id: state.nextId++ }));
        }

        return state;
    } catch (e) {
        return freshState();
    }
}

let state = loadState();

function save() {
    localStorage.setItem("dailyQuestSave", JSON.stringify(state));
}

function toast(message) {
    $("toast").textContent = message;
    $("toast").classList.add("show");
    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => $("toast").classList.remove("show"), 2300);
}

function levelForXP(xp) {
    let level = 1;
    let remaining = xp;

    while (remaining >= level * 100) {
        remaining -= level * 100;
        level++;
    }

    return { level, progress: remaining, needed: level * 100 };
}

function currentStats() {
    const levelInfo = levelForXP(state.xp);
    return {
        xp: state.xp,
        completed: state.completed,
        level: levelInfo.level,
        progress: levelInfo.progress,
        needed: levelInfo.needed
    };
}

function earnedAchievements() {
    const s = currentStats();
    return achievementDefinitions.map(a => ({ ...a, unlocked: a.test(s) }));
}

function claimChallengeIfReady() {
    const done = state.quests.filter(q => q.done).length;
    if (done >= 3 && !state.claimedChallenges.includes(today())) {
        state.xp += 100;
        state.claimedChallenges.push(today());
        toast("🎯 Daily challenge complete! +100 XP");
    }
}

function completeQuest(id) {
    const quest = state.quests.find(q => q.id === id);
    if (!quest) return;

    if (!quest.done) {
        quest.done = true;
        state.xp += quest.xp;
        state.completed++;
        state.completedDays[today()] = (state.completedDays[today()] || 0) + 1;

        const previousLevel = currentStats().level;
        updateStreak();
        claimChallengeIfReady();
        save();
        render();

        if (currentStats().level > previousLevel) {
            toast("🎉 Level up! You are now level " + currentStats().level);
        } else {
            toast("Quest completed! +" + quest.xp + " XP");
        }
    } else {
        toast("This quest is already completed.");
    }
}

function updateStreak() {
    if (state.lastCompletedDay === today()) return;

    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    const y = ${yesterday.getFullYear()}-${String(yesterday.getMonth()+1).padStart(2,'0')}-${String(yesterday.getDate()).padStart(2,'0')};

    if (state.lastCompletedDay === y) {
        state.streak++;
    } else {
        state.streak = 1;
    }

    state.lastCompletedDay = today();
}

function addQuest(event) {
    event.preventDefault();
    const title = $("questInput").value.trim();
    const xp = Number($("questReward").value);

    if (!title) return;

    state.quests.push({
        id: state.nextId++,
        title,
        category: "CUSTOM QUEST",
        xp,
        done: false
    });

    $("questInput").value = "";
    save();
    render();
    toast("New quest added!");
}

function renderQuestList(containerId) {
    const container = $(containerId);
    container.innerHTML = "";

    if (state.quests.length === 0) {
        container.innerHTML = '<div class="empty">No quests yet. Add your first quest above!</div>';
        return;
    }

    state.quests.forEach(q => {
        const row = document.createElement("div");
        row.className = "quest" + (q.done ? " completed" : "");

        const check = document.createElement("button");
        check.className = "check";
        check.textContent = q.done ? "✓" : "";
        check.setAttribute("aria-label", q.done ? "Completed quest" : "Complete quest");
        check.disabled = q.done;
        check.addEventListener("click", () => completeQuest(q.id));

        const info = document.createElement("div");
        info.className = "quest-info";

        const title = document.createElement("div");
        title.className = "quest-title";
        title.textContent = q.title;

        const category = document.createElement("span");
        category.className = "quest-category";
        category.textContent = q.category;

        info.append(title, category);

        const reward = document.createElement("span");
        reward.className = "reward";
        reward.textContent = "+" + q.xp + " XP";

        row.append(check, info, reward);
        container.appendChild(row);
    });
}

function renderAchievements() {
    const achievements = earnedAchievements();
    const unlocked = achievements.filter(a => a.unlocked).length;

    $("achievementCount").textContent = ${unlocked}/${achievements.length};

    $("achievementList").innerHTML = "";
    achievements.slice(0, 3).forEach(a => {
        const row = document.createElement("div");
        row.className = "achievement";

        const icon = document.createElement("div");
        icon.className = "badge-icon" + (a.unlocked ? "" : " locked");
        icon.textContent = a.icon;

        const info = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = a.name;
        const desc = document.createElement("small");
        desc.textContent = a.unlocked ? "Achievement unlocked!" : a.description;

        info.append(name, desc);
        row.append(icon, info);
        $("achievementList").appendChild(row);
    });

    $("achievementGrid").innerHTML = "";
    achievements.forEach(a => {
        const tile = document.createElement("div");
        tile.className = "achievement-tile";

        const icon = document.createElement("div");
        icon.className = "badge-icon" + (a.unlocked ? "" : " locked");
        icon.textContent = a.icon;

        const name = document.createElement("strong");
        name.textContent = a.name;

        const desc = document.createElement("p");
        desc.textContent = a.unlocked ? "✓ Unlocked" : a.description;

        tile.append(icon, name, desc);
        $("achievementGrid").appendChild(tile);
    });
}

function renderWeekly() {
    const days = [];
    for (let i = 6; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const key = ${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')};
        days.push({ key, label: d.toLocaleDateString("en-US", { weekday: "short" }) });
    }

    const values = days.map(d => state.completedDays[d.key] || 0);
    const max = Math.max(1, ...values);

    $("weekBars").innerHTML = "";
    days.forEach((d, i) => {
        const wrap = document.createElement("div");
        wrap.className = "day";

        const bar = document.createElement("div");
        bar.className = "bar" + (i === 6 ? " today" : "");
        bar.style.height = Math.max(5, (values[i] / max) * 85) + "px";
        bar.title = values[i] + " quests completed";

        const label = document.createElement("small");
        label.textContent = d.label;

        wrap.append(bar, label);
        $("weekBars").appendChild(wrap);
    });
}

function render() {
    const s = currentStats();
    const date = new Date();

    $("dateLabel").textContent = date.toLocaleDateString("en-US", {
        weekday: "long", month: "long", day: "numeric"
    }).toUpperCase();

    const hour = date.getHours();
    $("greeting").textContent =
        (hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening")
        + ", Adventurer.";

    $("levelTag").textContent = "LVL " + s.level;
    $("profileLevel").textContent = "Level " + s.level + " Explorer";

    $("xpNumber").textContent = s.progress.toLocaleString();
    $("xpTarget").textContent = "/ " + s.needed.toLocaleString() + " XP";
    $("xpBar").style.width = (s.progress / s.needed * 100) + "%";
    $("xpRemaining").textContent = (s.needed - s.progress) + " XP to next level";
    $("xpPercent").textContent = Math.floor(s.progress / s.needed * 100) + "%";

    $("streakNumber").textContent = state.streak + (state.streak === 1 ? " day" : " days");
    $("completedNumber").textContent = state.completed;
    $("totalXpStat").textContent = state.xp.toLocaleString() + " XP";
    $("totalQuestsStat").textContent = state.completed;

    const doneToday = state.quests.filter(q => q.done).length;
    $("questCount").textContent = ${doneToday}/${state.quests.length} completed;

    const challengeProgress = Math.min(doneToday, 3);
    $("challengeText").textContent = ${challengeProgress} of 3 completed;
    $("challengePercent").textContent = Math.round(challengeProgress / 3 * 100) + "%";
    $("challengeBar").style.width = (challengeProgress / 3 * 100) + "%";
    $("challengeReward").textContent =
        state.claimedChallenges.includes(today()) ? "✓ Bonus claimed!" : "Reward: +100 XP";

    renderQuestList("questList");
    renderQuestList("allQuestList");
    renderAchievements();
    renderWeekly();
}

document.querySelectorAll(".nav-item").forEach(item => {
    item.addEventListener("click", () => {
        document.querySelectorAll(".nav-item").forEach(n => n.classList.remove("active"));
        document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));

        item.classList.add("active");
        $(item.dataset.page).classList.add("active");
    });
});

$("questForm").addEventListener("submit", addQuest);

// Refresh the daily quest list on a new day.
if (state.lastVisitDay !== today()) {
    state.lastVisitDay = today();
    save();
}

render();
save();
</script>
</body>
</html>
