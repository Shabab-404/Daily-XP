<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Quest | Level Up Your Life</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
    --bg: #0b0c10;
    --panel: #14161d;
    --panel2: #1b1e27;
    --border: #292d38;
    --text: #f1f2f7;
    --muted: #9298a9;
    --purple: #a78bfa;
    --green: #5ee6a8;
    --gold: #f6c76b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

button, input, select {
    font: inherit;
}

button {
    cursor: pointer;
}

.app {
    display: grid;
    grid-template-columns: 225px minmax(0, 1fr);
    min-height: 100vh;
}

.sidebar {
    padding: 28px 18px;
    background: #101117;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
}

.logo {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 1px;
    margin: 0 0 42px 7px;
}

.logo-icon {
    width: 35px;
    height: 35px;
    display: grid;
    place-items: center;
    background: #28203e;
    color: var(--purple);
    border-radius: 11px;
    font-size: 21px;
}

.nav-label {
    font-size: 10px;
    color: var(--muted);
    font-weight: 700;
    letter-spacing: 1.5px;
    margin: 0 0 12px 10px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 12px;
    margin-bottom: 5px;
    color: var(--muted);
    border-radius: 10px;
    cursor: pointer;
    font-size: 13px;
    transition: .2s;
}

.nav-item:hover, .nav-item.active {
    background: #252034;
    color: var(--purple);
}

.sidebar-bottom {
    margin-top: auto;
    padding: 17px;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 13px;
}

.sidebar-bottom p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
}

.sidebar-bottom strong {
    display: block;
    margin-bottom: 7px;
    color: var(--text);
}

main {
    padding: 35px;
    max-width: 1550px;
    width: 100%;
    margin: auto;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}

.eyebrow {
    color: var(--purple);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

h1 {
    font-size: clamp(25px, 3vw, 34px);
    letter-spacing: -1.2px;
    margin-bottom: 9px;
}

.subtitle {
    color: var(--muted);
    font-size: 13px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 13px;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 13px;
    white-space: nowrap;
}

.avatar {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #34294f;
    font-size: 22px;
}

.profile small {
    display: block;
    color: var(--muted);
    margin-top: 5px;
    font-size: 11px;
}

.level-tag {
    color: var(--gold);
    font-size: 11px;
    font-weight: 800;
}

.stats {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 17px;
    margin-bottom: 24px;
}

.card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 23px;
    min-width: 0;
}

.xp-card {
    background: linear-gradient(120deg, #201932, #17151f 80%);
    border-color: #3a2c54;
}

.card-label {
    font-size: 12px;
