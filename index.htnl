    margin-bottom: 7px;
}

.stat-description {
    color: var(--muted);
    font-size: 11px;
}

.layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, 1fr);
    gap: 20px;
    align-items: start;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 7px;
}

h2 {
    font-size: 17px;
    letter-spacing: -.4px;
}

.count {
    color: var(--muted);
    font-size: 11px;
}

.section-description {
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 22px;
}

.quest-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.quest {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 15px;
    border: 1px solid var(--border);
    background: #181a22;
    border-radius: 12px;
    transition: .2s;
}

.quest:hover {
    border-color: #50416e;
}

.quest.completed {
    opacity: .58;
}

.quest.completed .quest-title {
    text-decoration: line-through;
}

.check {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border: 1.5px solid #555a6a;
    border-radius: 7px;
    display: grid;
    place-items: center;
    color: #101117;
    background: transparent;
    font-size: 13px;
}

.quest.completed .check {
    background: var(--green);
    border-color: var(--green);
}

.quest-info {
    flex: 1;
    min-width: 0;
}

.quest-title {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.quest-category {
    display: inline-block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 6px;
}

.reward {
    color: var(--gold);
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.add-quest {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 90px auto;
    gap: 8px;
    margin-top: 17px;
}

input, select {
    min-width: 0;
    width: 100%;
    padding: 12px;
    color: var(--text);
    background: #0f1016;
    border: 1px solid var(--border);
    border-radius: 9px;
    outline: none;
    font-size: 12px;
}

input:focus, select:focus {
    border-color: var(--purple);
}

.btn {
    padding: 11px 15px;
    border: 0;
    border-radius: 9px;
    background: var(--purple);
    color: #171020;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
}

.btn:hover {
    filter: brightness(1.12);
}

.side-column {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.challenge {
    background: linear-gradient(145deg, #242035, #18161f);
    border-color: #39304e;
}

.challenge-icon {
    font-size: 26px;
    margin-bottom: 16px;
}

.challenge h2 {
    margin-bottom: 9px;
}

.challenge p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
    margin-bottom: 18px;
}

.challenge-progress {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 11px;
}

.challenge-progress span:last-child {
    color: var(--purple);
}

.achievement-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 21px;
}

.achievement {
    display: flex;
    align-items: center;
    gap: 12px;
}

.badge-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: #272333;
    border: 1px solid #3b344e;
    border-radius: 12px;
